{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Personal site of Ganapati V S — meetguns.com",
  "homepage": "https://meetguns.com",
  "license": "MIT",
  "author": "Ganapati V S <vsg.inbox@gmail.com> (https://meetguns.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ganapativs/portfolio-v2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && pnpm index:submit",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint",
    "fix": "oxfmt && oxlint --fix",
    "knip": "knip",
    "index:submit": "node scripts/submit-index.mjs",
    "gen:favicon": "python3 scripts/gen-favicon.py",
    "gen:pwa-screenshots": "bash scripts/gen-pwa-screenshots.sh",
    "gen:kannada-subset": "python3 scripts/subset-kannada.py",
    "gen:og-fonts": "node scripts/gen-og-fonts.mjs",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@microcharts/react": "^0.18.1",
    "@next/mdx": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "glimm": "^0.3.0",
    "medium-zoom": "^1.1.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-spectrum": "^1.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix --quiet"
    ],
    "*.{json,jsonc,md,mdx,css}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
