{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Personal site of Ganapati V S — meetguns.com",
  "homepage": "https://meetguns.com",
  "license": "MIT",
  "author": "Ganapati V S <vsg.inbox@gmail.com> (https://meetguns.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ganapativs/portfolio-v2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint",
    "fix": "oxfmt && oxlint --fix",
    "knip": "knip",
    "index:submit": "node scripts/submit-index.mjs",
    "gen:favicon": "python3 scripts/gen-favicon.py",
    "gen:pwa-screenshots": "bash scripts/gen-pwa-screenshots.sh",
    "gen:kannada-subset": "python3 scripts/subset-kannada.py",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@microcharts/react": "^0.11.0",
    "@next/mdx": "^16.2.12",
    "@types/mdx": "^2.0.14",
    "glimm": "^0.3.0",
    "medium-zoom": "^1.1.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-spectrum": "^1.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": [
      "oxfmt",
      "oxlint --fix --quiet"
    ],
    "*.{md,mdx,css}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
